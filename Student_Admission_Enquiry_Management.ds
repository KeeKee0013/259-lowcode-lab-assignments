		workflow
		{
		form
		{
			validate_application_fee as "Validate Application Fee Before Submit"
			{
				type =  form
				form = admission_enquiry

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if application_fee is zero or negative
										if(input.application_fee <= 0)
										{
											// Display error message below the application_fee field
											alert(application_fee,"Application fee must be greater than zero.");
											// Cancel the submission
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			send_followup_reminder_email as "Send Follow-up Reminder Email"
			{
				type =  schedule
				form = enquiry_response
					status = inactive
				start = next_follow_up_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Check if follow-up date is today and status is pending
										if(input.next_follow_up_date == today && input.status == "Pending")
										{
											// Get the assigned staff email
											staffEmail = input.assigned_staff;
											// Check if staff email is valid
											if(!staffEmail.isNull())
											{
												// Send email notification to staff
												sendmail
												[
													from :zoho.loginuserid
													to :staffEmail
													subject :"Follow-up Required Today"
													message :"Dear Staff,\n\nYou have a pending follow-up scheduled for today.\n\nEnquiry ID: " + input.enquiry.ID.toString() + "\nFollow-up Date: " + input.next_follow_up_date.toString() + "\n\nPlease complete the follow-up as soon as possible.\n\nThank you."
												]
											}
										}
					)
					}
				}
			}
		}


