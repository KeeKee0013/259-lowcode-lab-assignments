 application "Student Admission Enquiry Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form admission_enquiry
		{
			displayname = "Admission Enquiry"
			success message = "Admission Enquiry Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			enquiry_id
			(
    			type = autonumber
				displayname = "Enquiry ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_birth
			(
    			type = date
				displayname = "Date Of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			gender
			(
				type = picklist
				displayname = "Gender"
				values = {"Male","Female","Other","Prefer Not To Say"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			enquiry_date
			(
    			type = datetime
				displayname = "Enquiry Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			enquiry_status
			(
				type = picklist
				displayname = "Enquiry Status"
				values = {"Visited","New","Approved","Withdrawn","Rejected","Contacted"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_fee
			(
				displayname = "Application Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_major
			(
				type = picklist
				displayname = "Preferred Major"
				values = {"Medicine","Engineering","Computer Science","Science","Arts","Business"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			enquiry_source
			(
				type = picklist
				displayname = "Enquiry Source"
				values = {"Social Media","Referral","Advertisement","Website","Walk In"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			qr_code
			(
    			type = url
				displayname = "QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			document_upload
			(
    			type = textarea
				displayname = "Document Upload"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Additional Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enquiry Received","Initial Screening","Enquiry Rejected","Document Verification","Pending Information","Fee Payment Required","Admission Interview","Under Review","Admission Approved","Admission Rejected","Waitlist","Enquiry Closed"}
			}
		}
