		workflow
		{
		form
		{
			auto_set_application_date as "Auto-set Application Date"
			{
				type =  form
				form = admission_enquiry

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set application_date to current datetime when new enquiry is created
										input.application_date = now;
						)
					}
				}

			}
			validate_contact_info as "Validate Contact Info Before Submit"
			{
				type =  form
				form = admission_enquiry

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate email field
										if(input.email.isEmpty())
										{
											alert "Error: Email address is required. Please provide a valid email address.";
											cancel submit;
										}
										// Validate phone number field
										if(input.phone_number.isEmpty())
										{
											alert "Error: Phone number is required. Please provide a valid phone number.";
											cancel submit;
										}
						)
					}
				}

			}
			notify_dept_head_admission as "Notify Department Head on Admission"
			{
				type =  form
				form = admission_enquiry

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the admission enquiry record where status is Admitted
										admittedRecords = admission_enquiry[enquiry_status == "Admitted"];
										// Check if any records were found
										if(admittedRecords.count() > 0)
										{
											// Iterate through each admitted record
											for each  record in admittedRecords
											{
												// Get the department name from the record
												departmentName = record.department;
												// Fetch the department details for the specific department
												departmentDetails = department_details[department_name == departmentName];
												// Check if department details exist
												if(departmentDetails.count() > 0)
												{
													// Get the head of department's name
													headOfDepartment = departmentDetails.head_of_department;
													// Get the contact email of the head of department
													headEmail = departmentDetails.contact_email;
													// Get the student's name
													studentName = record.student_name.first_name;
													// Get the contact person's name
													contactPerson = record.contact_person.first_name;
													// Check if head email is not null
													if(headEmail.isNull() == false)
													{
														// Send email to department head
														sendmail
														[
															from :zoho.loginuserid
															to :headEmail
															subject :"New Student Admission: " + studentName
															message :"Dear " + headOfDepartment.first_name + ",\n\nA new student has been admitted to the " + departmentName + " department.\n\nStudent Name: " + studentName + "\nContact Person: " + contactPerson + "\n\nPlease take necessary actions.\n\nRegards,\nAdmission Team"
														]
													}
												}
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			weekly_followup_reminder as "Weekly Follow-up Reminder"
			{
				type =  schedule
				form = admission_enquiry
					status = inactive
				start = follow_up_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch records with follow_up_date in the next 7 days and enquiry_status not as Admitted or Rejected
										pendingFollowUps = admission_enquiry[follow_up_date in next 7 days && enquiry_status != "Admitted" && enquiry_status != "Rejected"];
										// Iterate through each pending follow-up record
										for each  record in pendingFollowUps
										{
											// Check if follow_up_date is not null
											if(!record.follow_up_date.isNull())
											{
												// Format the follow-up date for the email message
												followUpDateFormatted = record.follow_up_date.getDateTime();
												// Get the contact person's name
												contactPersonName = record.contact_person.first_name;
												// Send email notification
												sendmail
												[
													from :zoho.loginuserid
													to :record.email
													subject :"Reminder: Follow-up Scheduled for " + followUpDateFormatted
													message :"Dear " + contactPersonName + ",\n\nThis is a reminder that a follow-up is scheduled for " + followUpDateFormatted + ".\n\nPlease ensure you are prepared for the meeting.\n\nBest regards,\nAdmission Team"
												]
											}
										}
					)
					}
				}
			}
		}


