	reports
	{
		list admission_enquiry_Report
		{
			displayName = "All Admission Enquiries"
			show all rows from admission_enquiry    
			(
				student_name  as "Student Name"
				email as "Email Address"
				phone_number as "Phone Number"
				date_of_birth as "Date Of Birth"
				gender as "Gender"
				address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				qualification as "Qualification"
				stream as "Stream"
				department as "Department"
				application_date as "Application Date"
				enquiry_status as "Enquiry Status"
				source as "Source"
				qr_code as "QR Code"
				document_upload as "Document Upload"
				contact_person  as "Contact Person"
				remarks as "Remarks"
				contact_date as "Contact Date"
				follow_up_date as "Follow Up Date"
				priority as "Priority"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (stream == "Commerce")
				fields = [stream]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (stream == "Engineering")
				fields = [stream]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (stream == "Management")
				fields = [stream]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban admission_enquiry_by_department
		{
			displayName = "Departments"
			show all rows from admission_enquiry    
			(
				student_name  as "Student Name"
				email as "Email Address"
				phone_number as "Phone Number"
				date_of_birth as "Date Of Birth"
				gender as "Gender"
				address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				qualification as "Qualification"
				stream as "Stream"
				department as "Department"
				application_date as "Application Date"
				enquiry_status as "Enquiry Status"
				source as "Source"
				qr_code as "QR Code"
				document_upload as "Document Upload"
				contact_person  as "Contact Person"
				remarks as "Remarks"
				contact_date as "Contact Date"
				follow_up_date as "Follow Up Date"
				priority as "Priority"
			)
			options
			(
	 			display field = department
	 		)
		}
		list department_details_Report
		{
			displayName = "Department Details Report"
			show all rows from department_details    
			(
				department_name as "Department Name"
				department_code as "Department Code"
				head_of_department  as "Head Of Department"
				contact_email as "Contact Email"
				contact_phone as "Contact Phone"
				established_year as "Established Year"
				budget as "Budget"
				(
					display = total,average,min,max	
				)
				capacity as "Capacity"
				location as "Location"
				description as "Description"
				enquiry_count as "Enquiry Count"
				active_status as "Active Status"
				created_date as "Created Date"
				updated_date as "Updated Date"
			)
		}
		list enquiry_source_Report
		{
			displayName = "All Sources"
			show all rows from enquiry_source    
			(
				source_name as "Source Name"
				source_code as "Source Code"
				source_type as "Source Type"
				description as "Description"
				conversion_rate as "Conversion Rate"
				(
					display = total,average,min,max	
				)
				cost_per_lead as "Cost Per Lead"
				(
					display = total,average,min,max	
				)
				active_status as "Active Status"
				created_date as "Created Date"
				updated_date as "Updated Date"
				total_enquiries as "Total Enquiries"
				total_admissions as "Total Admissions"
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (source_type == "Offline")
				fields = [source_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (source_type == "Online")
				fields = [source_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (source_type == "Referral")
				fields = [source_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban enquiry_source_by_source_type
		{
			displayName = "Source Types"
			show all rows from enquiry_source    
			(
				source_name as "Source Name"
				source_code as "Source Code"
				source_type as "Source Type"
				description as "Description"
				conversion_rate as "Conversion Rate"
				(
					display = total,average,min,max	
				)
				cost_per_lead as "Cost Per Lead"
				(
					display = total,average,min,max	
				)
				active_status as "Active Status"
				created_date as "Created Date"
				updated_date as "Updated Date"
				total_enquiries as "Total Enquiries"
				total_admissions as "Total Admissions"
				notes as "Notes"
			)
			options
			(
	 			display field = source_type
	 		)
		}
	}
	pages
	{
		page DashBoard
